---
import 'flickity/css/flickity.css';
import '../styles/global.css';
import '../styles/components/header.css';
import '../styles/components/hero.css';
import '../styles/components/about.css';
import '../styles/components/map.css';
import '../styles/components/footer.css';
import '../styles/utils.css';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Ponyboy Barbershop - A modern barbershop in the heart of Tulsa's East Village. Classic cuts, modern styles, and a welcoming atmosphere. Walk-ins welcome!">
    <meta name="theme-color" content="#212121">
    <title>Ponyboy Barbershop | Tulsa's Premier Barbershop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <!-- Skip link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="header">
        <div class="header__content container">
            <a href="/" aria-label="Ponyboy Barbershop - Home">
                <img src="/assets/img/Ponyboy_logo_154x52.png" alt="Ponyboy Barbershop" class="header__logo" width="154" height="52">
            </a>
            <nav class="nav" aria-label="Main navigation">
                <a href="https://getsquire.com/booking/brands/ponyboy" class="btn btn--sm">Book Cut</a>
                <a href="https://instagram.com/ponyboybarbershop/" class="header__instagram-link" aria-label="Follow us on Instagram" target="_blank" rel="noopener noreferrer">
                    <img src="/assets/img/icon-instagram.png" alt="" width="24" height="24" aria-hidden="true">
                </a>
            </nav>
        </div>
    </header>

    <main id="main-content">
        <section class="hero" aria-labelledby="hero-heading">
            <div class="hero__decoration hero__decoration--1" aria-hidden="true"></div>
            <div class="hero__decoration hero__decoration--2" aria-hidden="true"></div>
            <div class="hero__content container">
                <div class="hero__text">
                    <h1 id="hero-heading" class="hero__h1 h1">
                        Welcome to <span class="h1--green">Ponyboy</span>, a modern barbershop <span class="h1--green">with an old-school feel.</span>
                    </h1>
                    <p class="hero__tagline">🥇 Tulsa A-list best barbershop 2025<br>🏆 Tulsa World best barbershop 2025</p>
                    <div class="hero__cta-group">
                        <a href="https://getsquire.com/booking/brands/ponyboy" class="btn btn--primary">Book Cut</a>
                        <a href="#location" class="btn btn--sm" style="background: transparent; border: 1px solid rgba(255,255,255,0.2);">Find Us →</a>
                    </div>
                </div>
                <div class="hero__video-wrapper">
                    <video 
                        class="hero__video" 
                        src="/assets/video/Ponyboy_video_Compressed.mp4" 
                        playsinline 
                        autoplay 
                        muted 
                        loop
                        aria-label="Ponyboy Barbershop atmosphere video"
                    ></video>
                </div>
            </div>
        </section>

        <section class="about" aria-labelledby="about-heading">
            <div class="about__content">
                <h2 id="about-heading" class="sr-only">About Ponyboy</h2>
                <p class="about__h1 container">
                    <span class="about__h1--green">We're all about making everyone feel at home.</span> 
                    Whether you want a classic cut or something more trendy, 
                    <span class="about__h1--green">our skilled barbers are here to help.</span>
                </p>
                
                <div class="about__services" role="list" aria-label="Our services">
                    <span class="service-badge" role="listitem">Classic Cuts</span>
                    <span class="service-badge" role="listitem">Hot Towel Shaves</span>
                    <span class="service-badge" role="listitem">Beard Trims</span>
                    <span class="service-badge" role="listitem">Modern Styles</span>
                    <span class="service-badge" role="listitem">Kids Cuts</span>
                </div>

                <a href="/about" class="about__link">Learn more about us →</a>

                <div class="carousel js-flickity" role="region" aria-label="Photo gallery" aria-roledescription="carousel">
                    <div class="carousel-cell"><img src="/assets/img/img_1.jpg" alt="Interior of Ponyboy Barbershop" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_2.jpg" alt="Barber working with a client" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_3.jpg" alt="Classic barbershop details" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_4.jpg" alt="Styling station" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_5.jpg" alt="Barbershop atmosphere" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_6.jpg" alt="Grooming products" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_7.jpg" alt="Customer getting a haircut" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_8.jpg" alt="Barbershop team" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_9.jpg" alt="Finished haircut style" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_10.jpg" alt="Shop exterior" loading="lazy"></div>
                    <div class="carousel-cell"><img src="/assets/img/img_11.jpg" alt="Client experience" loading="lazy"></div>
                </div>
                
                <a href="https://getsquire.com/booking/brands/ponyboy" class="btn btn--primary">Book Your Appointment</a>
            </div>
        </section>

        <section class="map" id="location" aria-labelledby="location-heading">
            <div class="map__header container">
                <h2 id="location-heading" class="map__heading h1--fraunces h1--fraunces--bold">Visit Us</h2>
                <p class="map__subtitle">Two convenient locations serving Tulsa and Bixby. Walk-ins always welcome. Appointments preferred.</p>
            </div>
            
            <div class="map__locations container">
                <!-- Tulsa Location -->
                <article class="map__location">
                    <div class="map__location-header">
                        <svg class="map__location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <h3 class="map__location-name">Tulsa - East Village</h3>
                    </div>
                    <div class="map__embed-wrapper">
                        <iframe 
                            class="map__embed" 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3221.4106974239235!2d-95.98428358750554!3d36.156559403600276!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b6eda6eac61aa3%3A0x57cf4becd725104c!2sPonyboy%20barbershop!5e0!3m2!1sen!2sus!4v1733206029356!5m2!1sen!2sus" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Ponyboy Barbershop Tulsa location on Google Maps"
                        ></iframe>
                    </div>
                    <div class="map__info">
                        <div class="map__details">
                            <div class="map__detail">
                                <svg class="map__detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <div class="map__detail-content">
                                    <span class="map__detail-label">Address</span>
                                    <span class="map__detail-value">810 E 3rd St, Tulsa, OK 74120</span>
                                </div>
                            </div>
                            <div class="map__detail">
                                <svg class="map__detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                                <div class="map__detail-content">
                                    <span class="map__detail-label">Phone</span>
                                    <a href="tel:+19185503673" class="map__detail-value map__detail-link">(918) 550-3673</a>
                                </div>
                            </div>
                            <div class="map__detail">
                                <svg class="map__detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="3" y1="9" x2="21" y2="9"></line>
                                    <line x1="9" y1="21" x2="9" y2="9"></line>
                                </svg>
                                <div class="map__detail-content">
                                    <span class="map__detail-label">Parking</span>
                                    <span class="map__detail-note">Free street parking on South Kenosha Ave</span>
                                </div>
                            </div>
                            <a 
                                href="https://maps.google.com/?q=810+E+3rd+St,+Tulsa,+OK+74120" 
                                class="map__directions"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                                </svg>
                                Get Directions
                                <span class="map__directions-icon" aria-hidden="true">→</span>
                            </a>
                        </div>
                        
                        <div class="map__hours">
                            <div class="map__hours-header">
                                <svg class="map__hours-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <h4 class="map__hours-title">Hours</h4>
                            </div>
                            <div class="map__hours-list">
                                <div class="map__hours-row">
                                    <span class="map__hours-day">Mon – Sat</span>
                                    <span class="map__hours-time">9am – 5:30pm</span>
                                </div>
                                <div class="map__hours-row">
                                    <span class="map__hours-day">Sunday</span>
                                    <span class="map__hours-time map__hours-time--closed">Closed</span>
                                </div>
                            </div>
                            <p class="map__walkins-note">
                                <svg class="map__walkins-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Walk-ins welcome
                            </p>
                        </div>
                    </div>
                </article>

                <!-- Bixby Location -->
                <article class="map__location">
                    <div class="map__location-header">
                        <svg class="map__location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <h3 class="map__location-name">Bixby</h3>
                    </div>
                    <div class="map__embed-wrapper">
                        <iframe 
                            class="map__embed" 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3228.8291122071078!2d-95.8895434241991!3d35.97560317249371!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87b68f135013831d%3A0xb24610d92dfedbae!2sPonyboy%20Barbershop!5e0!3m2!1sen!2sus!4v1764973538076!5m2!1sen!2sus" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Ponyboy Barbershop Bixby location on Google Maps"
                        ></iframe>
                    </div>
                    <div class="map__info">
                        <div class="map__details">
                            <div class="map__detail">
                                <svg class="map__detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <div class="map__detail-content">
                                    <span class="map__detail-label">Address</span>
                                    <span class="map__detail-value">12918 S Memorial Dr, Bixby, OK 74008</span>
                                </div>
                            </div>
                            <div class="map__detail">
                                <svg class="map__detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                                <div class="map__detail-content">
                                    <span class="map__detail-label">Phone</span>
                                    <a href="tel:+19185503023" class="map__detail-value map__detail-link">(918) 550-3023</a>
                                </div>
                            </div>
                            <a 
                                href="https://maps.google.com/?q=12918+S+Memorial+Dr,+Bixby,+OK+74008" 
                                class="map__directions"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                                </svg>
                                Get Directions
                                <span class="map__directions-icon" aria-hidden="true">→</span>
                            </a>
                        </div>
                        
                        <div class="map__hours">
                            <div class="map__hours-header">
                                <svg class="map__hours-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <h4 class="map__hours-title">Hours</h4>
                            </div>
                            <div class="map__hours-list">
                                <div class="map__hours-row">
                                    <span class="map__hours-day">Mon – Sat</span>
                                    <span class="map__hours-time">10am – 5pm</span>
                                </div>
                                <div class="map__hours-row">
                                    <span class="map__hours-day">Sunday</span>
                                    <span class="map__hours-time map__hours-time--closed">Closed</span>
                                </div>
                            </div>
                            <p class="map__walkins-note">
                                <svg class="map__walkins-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Walk-ins welcome
                            </p>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer__content container">
            <img class="footer__logo" src="/assets/img/Ponyboy_logo_154x52.png" alt="Ponyboy Barbershop" width="154" height="52">
            
            <div class="footer__social">
                <a href="https://instagram.com/ponyboybarbershop/" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                    <img src="/assets/img/icon-instagram.png" alt="" aria-hidden="true">
                </a>
            </div>
            
            <nav class="footer__nav" aria-label="Footer navigation">
                <a href="https://getsquire.com/booking/brands/ponyboy" class="footer__link">Book Now</a>
                <a href="/about" class="footer__link">About</a>
                <a href="#location" class="footer__link">Location</a>
                <a href="mailto:nick1995watson@yahoo.com" class="footer__link">Contact</a>
            </nav>
            
            <p class="footer__copyright">© 2024 Ponyboy Barbershop. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // @ts-ignore - flickity types
        import Flickity from 'flickity';
        import 'flickity-imagesloaded';
        import { animate } from 'motion';

        // Initialize Flickity carousel
        const carouselElement = document.querySelector('.js-flickity');
        if (carouselElement) {
            new Flickity(carouselElement, {
                imagesLoaded: true,
                wrapAround: true,
                cellAlign: 'center',
                percentPosition: true,
                autoPlay: 4000,
                pauseAutoPlayOnHover: true,
                pageDots: true,
                prevNextButtons: true,
                accessibility: true,
                ariaLabel: 'Photo gallery carousel'
            });
        }

        // Header scroll effect
        const header = document.querySelector('.header');
        if (header) {
            let lastScroll = 0;
            window.addEventListener('scroll', () => {
                const currentScroll = window.scrollY;
                if (currentScroll > 50) {
                    header.classList.add('header--scrolled');
                } else {
                    header.classList.remove('header--scrolled');
                }
                lastScroll = currentScroll;
            }, { passive: true });
        }

        // Hero animations
        const heroVideo = document.querySelector('.hero__video');
        if (heroVideo) {
            animate(heroVideo, 
                { opacity: [0, 1], scale: [0.95, 1] }, 
                { duration: 1.2, ease: [0.22, 1, 0.36, 1] }
            );
        }

        const heroText = document.querySelector('.hero__text');
        if (heroText) {
            animate(heroText, 
                { opacity: [0, 1], x: [-30, 0] }, 
                { duration: 0.8, ease: [0.22, 1, 0.36, 1], delay: 0.2 }
            );
        }

        // Scroll-triggered animations for about section
        const serviceBadges = document.querySelectorAll<HTMLElement>('.service-badge');
        const aboutContent = document.querySelector('.about__content');
        if (serviceBadges.length && aboutContent) {
            // Set initial state
            serviceBadges.forEach((badge, index) => {
                badge.style.opacity = '0';
                badge.style.transform = 'translateY(20px)';
                badge.style.transition = `opacity 0.5s ease-out ${index * 0.1}s, transform 0.5s ease-out ${index * 0.1}s`;
            });
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        serviceBadges.forEach(badge => {
                            badge.style.opacity = '1';
                            badge.style.transform = 'translateY(0)';
                        });
                        observer.disconnect();
                    }
                });
            }, { threshold: 0.3 });
            
            observer.observe(aboutContent);
        }

        // Smooth scroll for anchor links
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', (e: Event) => {
                const href = anchor.getAttribute('href');
                if (href && href !== '#') {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            });
        });
    </script>
</body>
</html>
